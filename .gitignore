# ===== 依赖（依赖体积大，不应入库）=====
node_modules/
client/node_modules/
server/node_modules/

# ===== 构建产物 / 缓存 =====
dist/
build/
.output/
.vite/
client/dist/
client/build/
server/dist/
server/build/

# ===== 日志文件 =====
*.log
backend.log
backend_smoke.log
frontend.log
frontend_smoke.log
start.log

# ===== npm 缓存目录（安装过程残留）=====
client/.npmcache_clean/

# ===== 环境变量 / 密钥（含明文配置，勿入库）=====
.env
.env.*
!.env.example

# ===== 运行时数据（含第三方模型 API Key 与对局状态，勿入库）=====
server/data/
# 保留目录结构占位，应用启动会自动重建该目录
!server/data/.gitkeep

# ===== 调试 / 临时产物（根目录散落的临时文件）=====
_procs*.txt
check_result.txt
view_full.txt
view_out.txt
done.txt
client_install*.log

# ===== 客户端安装日志残留 =====
client/install*.log

# ===== 编辑器 / 系统 =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ===== WorkBuddy / 工具内部数据（含项目记忆与设置，勿入库）=====
.workbuddy/
