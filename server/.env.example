# 后端监听端口（默认 3001）
PORT=3001

# 允许跨域的前端地址，多个用逗号分隔；设为 * 允许全部
CORS_ORIGIN=http://localhost:5173

# SSE 心跳间隔（毫秒）
SSE_HEARTBEAT_MS=15000

# 单次 LLM 调用超时（毫秒，决策 4：30 秒）
LLM_TIMEOUT_MS=30000

# 同一 baseUrl 的最小调用间隔（毫秒，决策 5：≥800ms）
MIN_LLM_INTERVAL_MS=800

# 反向代理（Nginx/负载均衡）后部署时设为代理层数（如 1）或 true；
# 直连部署请勿开启，否则 X-Forwarded-For 可被伪造绕过限流
# TRUST_PROXY=1

# 运行环境：设为 production 时 500 错误只返回通用文案（不泄露内部错误详情）
# NODE_ENV=production

# 注意：第三方模型 API Key 不放在这里，由「模型配置」持久化到 server/data/modelConfigs.json，
# 且永不出现在任何 HTTP 响应中（见 store.toPublicModelConfig）。
